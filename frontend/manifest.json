{
  "manifest_version": 3,
  "name": "Simplate",
  "version": "1.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Simplate"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:5000 http://127.0.0.1:5000;"
  }
}